<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (Android 12+) for An Nhiên.
    Excludes sensitive health data from cloud backup AND device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="attachments" />
        <exclude domain="file" path="backups" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allow device transfer only for non-sensitive preferences -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="attachments" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
